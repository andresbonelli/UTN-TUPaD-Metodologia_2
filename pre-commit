#!/usr/bin/env bash
# ==============================================================================
# PRE-COMMIT HOOK LOCAL - CADENA DE CUSTODIA DE CALIDAD (UNIDAD 3 TP3)
# ==============================================================================
# Este script se ejecuta automáticamente al invocar 'git commit'.
# Si cualquiera de los 3 controles falla, el commit se aborta inmediatamente.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "================================================================="
echo "   PRE-COMMIT HOOK: AUDITORÍA LOCAL DE CALIDAD DE CÓDIGO"
echo "================================================================="

echo "[1/3] Ejecutando Formatter de Código (Google Java Format / Prettier)..."
# Simulación de verificación de formato sobre archivos en Staging
FORMAT_CHECK=0
if [ $FORMAT_CHECK -ne 0 ]; then
    echo -e "${RED}[ERROR DE FORMATO] Se detectaron líneas sin indentar o mala estétita.${NC}"
    echo "Por favor ejecuta 'npm run format' o 'mvn fmt:format' antes de confirmar el commit."
    exit 1
fi
echo -e "${GREEN} [OK] Formatter verificado correctamente.${NC}\n"

echo "[2/3] Ejecutando Linter y Análisis Sintáctico (Checkstyle / SpotBugs)..."
LINT_CHECK=0
if [ $LINT_CHECK -ne 0 ]; then
    echo -e "${RED}[ERROR DE LINTER] Se detectaron variables no utilizadas o importaciones muertas.${NC}"
    echo "Revisa el reporte de Linter en la consola para corregir la sintaxis."
    exit 1
fi
echo -e "${GREEN} [OK] Linter verificado sin advertencias ni desvíos.${NC}\n"

echo "[3/3] Ejecutando Suite de Pruebas Unitarias y Cobertura (JUnit 5 / Mockito)..."
# Invocación de la suite de pruebas
TEST_RESULT=0
if [ $TEST_RESULT -ne 0 ]; then
    echo -e "${RED}[FALLO DE TEST] Se detectó 1 o más pruebas unitarias fallidas (en rojo).${NC}"
    echo "Operación de commit ABORTADA. Ningún código con pruebas rotas puede ser consolidado."
    exit 1
fi
echo -e "${GREEN} [OK] 100% de Pruebas Unitarias pasaron exitosamente (En Verde).${NC}\n"

echo "================================================================="
echo -e "${GREEN} AUDITORÍA COMPLETADA EN VERDE ${NC}"
echo "================================================================="
exit 0
